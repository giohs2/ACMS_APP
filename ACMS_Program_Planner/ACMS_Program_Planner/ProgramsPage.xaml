<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ACMS_Program_Planner.ProgramsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ACMS_Program_Planner"
    xmlns:models="using:ACMS_Program_Planner.Models"
    xmlns:sys="using:System">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.3*" />
            <ColumnDefinition Width="0.7*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column -->
        <StackPanel Grid.Column="0" Margin="10">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Programs" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Margin="10,0,0,0" Grid.Column="0" />
                <Button Content="Add Program" Click="AddProgramButton_Click" Grid.Column="1" />
            </Grid>
            <ListView x:Name="ProgramsListView" SelectionChanged="ProgramsListView_SelectionChanged" ItemsSource="{x:Bind Programs}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProgramItem">
                        <StackPanel Margin="0,5,0,5">
                            <TextBlock Text="{x:Bind sys:String.Format('Program Id: {0}', Id)}" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind sys:String.Format('Name: {0}', Name), Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- Right Column -->
        <Border Grid.Column="1" Background="{StaticResource LayerFillColorDefaultBrush}" Margin="8" CornerRadius="8">
            <Grid x:Name="ProgramGrid" Visibility="Collapsed" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="10">
                    <TextBlock x:Name="ProgramId" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,24" />
                    <TextBlock Text="Name" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,12" />
                    <TextBox x:Name="ProgramNameTextBox" Margin="0,0,0,16" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="0.5*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Text="Available Steps" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
                            <ListView x:Name="AvailableStepsListView" SelectionChanged="AvailableStepsListView_SelectionChanged" ItemsSource="{x:Bind Steps}" 
                                      BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" MinHeight="300" MaxHeight="300"
                                      CanDragItems="True" SelectionMode="Single" AllowDrop="True" DragItemsStarting="AvailableStepsListView_DragItemsStarting"
                                      DragOver="AvailableStepsListView_DragOver">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:StepItem">
                                        <StackPanel Margin="0,5,0,5">
                                            <TextBlock Text="{x:Bind sys:String.Format('Step Id: {0}', Id)}" FontWeight="Bold" />
                                            <TextBlock Text="{x:Bind sys:String.Format('Name: {0}', Name), Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                        <Grid Grid.Column="1" Grid.Row="0">
                            <FontIcon Glyph="&#xE8AB;" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Selected Steps" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
                                    <!--Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" Click="DeleteSelectedStepsButton_Click" /-->
                                </Grid>
                                <ListView x:Name="SelectedStepsListView" Grid.Row="1" SelectionChanged="SelectedStepsListView_SelectionChanged" ItemsSource="{x:Bind SelectedSteps, Mode=OneWay}"
                                          BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" MinHeight="300" MaxHeight="300"
                                          CanDragItems="True" CanReorderItems="True" AllowDrop="True" SelectionMode="Single" Drop="SelectedStepsListView_Drop" DragOver="SelectedStepsListView_DragOver"
                                          DragItemsStarting="SelectedStepsListView_DragItemsStarting" DragItemsCompleted="SelectedStepsListView_DragItemsCompleted">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:StepItem">
                                            <StackPanel Margin="0,5,0,5">
                                                <TextBlock Text="{x:Bind sys:String.Format('Step Id: {0}', Id)}" FontWeight="Bold" />
                                                <TextBlock Text="{x:Bind sys:String.Format('Name: {0}', Name), Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <StackPanel>
                        <Grid x:Name="InfoPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Height="1" Margin="0, 10, 0, 10" Background="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="1" Text="Drag and drop Steps. Select a Step to see the details." Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="StepDetails" Visibility="Collapsed">
                            <Border Height="1" Margin="0, 10, 0, 10" Background="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="StepId" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,24" />
                            <TextBlock x:Name="StepName" Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,12" />
                            <TextBlock x:Name="StepTime" Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,12" />
                            <TextBlock x:Name="StepTemperature" Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,12" />
                            <TextBlock x:Name="IsSteamerActive" Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,12" />
                            <TextBlock Text="Termination of Step:" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,12" />
                            <TextBlock x:Name="TerminateIfTemperatureReached" Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,12" />
                            <TextBlock x:Name="TerminateIfTimeExpired" Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,12" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
