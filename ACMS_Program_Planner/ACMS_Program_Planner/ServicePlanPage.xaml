<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ACMS_Program_Planner.ServicePlanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ACMS_Program_Planner"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ACMS_Program_Planner.Models"
    xmlns:sys="using:System"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="CycleTemplate" x:DataType="models:Cycle">
            <TreeViewItem
                ItemsSource="{x:Bind UnitPrograms}" IsExpanded="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Bind Name}" />
                </StackPanel>
            </TreeViewItem>
        </DataTemplate>

        <DataTemplate x:Key="UnitTemplate" x:DataType="models:UnitProgram">
            <TreeViewItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Bind Unit.UnitName}"/>
                </StackPanel>
            </TreeViewItem>
        </DataTemplate>

        <local:CycleItemTemplateSelector x:Key="CycleItemTemplateSelector"
            CycleTemplate="{StaticResource CycleTemplate}"
            UnitTemplate="{StaticResource UnitTemplate}" />
    </Page.Resources>

    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.3*" />
            <ColumnDefinition Width="0.7*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Service Plans" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Margin="10,0,0,0" Grid.Column="0" />
                <Button Content="Add Plan" Click="Button_Click" Grid.Column="1" />
            </Grid>
            <ListView Grid.Row="1" x:Name="PlansListView" SelectionChanged="PlansListView_SelectionChanged" ItemsSource="{x:Bind ServicePlans}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ServicePlanItem">
                        <StackPanel Margin="0, 5, 0, 5">
                            <TextBlock Text="{x:Bind sys:String.Format('Plan Id: {0}', Id)}" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind sys:String.Format('Name: {0}', Name), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind sys:String.Format('Flight: {0}', FlightName), Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Right Column -->
        <Border Grid.Column="1" Background="{StaticResource LayerFillColorDefaultBrush}" Margin="8" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--SelectorBar Grid.Row="0" x:Name="SelectorBar" SelectionChanged="SelectorBar_SelectionChanged">
                    <SelectorBarItem x:Name="SelectorBarItem1" Text="Galley 1" IsSelected="True" />
                    <SelectorBarItem x:Name="SelectorBarItem2" Text="Galley 2" />
                    <SelectorBarItem x:Name="SelectorBarItem3" Text="Galley 3" />
                </SelectorBar-->
                <StackPanel Grid.Row="1" x:Name="FormPanel" Visibility="Collapsed" Margin="16, 32, 16, 24">
                    <TextBlock x:Name="PlanId" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,24" />
                    <TextBlock Text="Name" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,12" />
                    <TextBox x:Name="NameTextBox" Margin="0,0,0,16" Width="250" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Flight" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,12" />
                    <ComboBox x:Name="FlightsComboBox"
                              DisplayMemberPath="CombinedFlightName"
                              SelectedValuePath="CombinedFlightName"
                              SelectedItem="{Binding Flight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,16"
                              Width="250"
                              HorizontalAlignment="Left"
                              HorizontalContentAlignment="Left" SelectionChanged="FlightsComboBox_SelectionChanged" />
                    <!--TextBlock Text="Units and Programs" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="UnitsComboBox"
                                  DisplayMemberPath="UnitName"
                                  SelectedValuePath="UnitName"
                                  SelectedValue="{Binding Unit, Mode=TwoWay}"
                                  Margin="0,0,10,0"
                                  Width="250"
                                  HorizontalAlignment="Left"
                                  HorizontalContentAlignment="Left" SelectionChanged="UnitsComboBox_SelectionChanged" />
                        <ComboBox x:Name="ProgramsComboBox"
                                    DisplayMemberPath="Name"
                                    SelectedValuePath="Id"
                                    SelectedValue="{Binding ProgramItem, Mode=TwoWay}"
                                    Margin="0,0,0,16"
                                    Width="250"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left" SelectionChanged="ProgramsComboBox_SelectionChanged" />
                    </StackPanel-->

                    <TextBlock Text="Cycles" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,12" />
                    <Button x:Name="AddCycleButton" Content="Add Cycle" Click="Add_CycleButton_Click" />
                    <Grid Margin="0, 10, 10, 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TreeView Grid.Column="0" x:Name="CyclesTreeView" SelectionChanged="CyclesTreeView_SelectionChanged" SelectionMode="Single"
                                  ItemsSource="{x:Bind ServiceSteps, Mode=OneWay}" ItemTemplateSelector="{StaticResource CycleItemTemplateSelector}"
                                  BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" 
                                  MinHeight="300" MaxHeight="300" MinWidth="200" Margin="10">
                        </TreeView>
                        <StackPanel Grid.Column="1" x:Name="ItemDetails" Visibility="Collapsed" Margin="10">
                            <TextBlock x:Name="ItemTitle" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0, 0, 0, 12" />
                            <TimePicker x:Name="TimeBetween" Header="Delay Next Step by" Margin="0, 0, 0, 12" SelectedTimeChanged="TimeBetween_SelectedTimeChanged"/>
                            <TextBlock x:Name="ProgramsComboBoxTitle" Margin="0, 0, 0, 12" />
                            <ComboBox x:Name="ProgramsComboBox" Margin="0, 0, 0, 12"
                                DisplayMemberPath="Name"
                                SelectedValuePath="Id"
                                SelectedItem="{Binding Program, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Left" SelectionChanged="ProgramsComboBox_SelectionChanged" />
                            <TextBlock x:Name="StartOffsetNumberBoxTitle" Margin="0, 0, 0, 12" />
                            <NumberBox x:Name="StartOffsetNumberBox" MaxWidth="120" ValueChanged="StartOffsetNumberBox_ValueChanged"
                                Minimum="0" SpinButtonPlacementMode="Compact" HorizontalAlignment="Left" />
                        </StackPanel>
                        
                        
                        <!--Grid Grid.Column="1" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ListView Grid.Row="0" x:Name="CycleDetailsListView"
                                  BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" MinHeight="300" MaxHeight="300" MinWidth="200">
                                <ListView.Header>
                                    <Grid Padding="16,12"
                                            ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Unit" />
                                        <TextBlock Grid.Column="1" Text="Program" />
                                        <TextBlock Grid.Column="2" Text="Time offset" />
                                    </Grid>
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:UnitProgram">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Unit.UnitName}" />
                                            <ComboBox x:Name="ProgramsComboBox" Grid.Column="1" ItemsSource="{Binding Programs, Mode=OneWay}"
                                                DisplayMemberPath="Name"
                                                SelectedValuePath="Id"
                                                SelectedValue="{Binding Program, Mode=OneWay}"
                                                HorizontalAlignment="Left"
                                                HorizontalContentAlignment="Left" SelectionChanged="ProgramsComboBox_SelectionChanged" />
                                            <NumberBox Grid.Column="2"
                                                Minimum="0" SpinButtonPlacementMode="Compact" Value="{Binding StartOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}"
                                            TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                            <TimePicker Grid.Row="1" x:Name="TimeBetween" Header="Delay Next Step by" SelectedTime="{x:Bind ((models:Cycle)CyclesListView.SelectedItem).Delay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid-->
                    </Grid>
                    
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
