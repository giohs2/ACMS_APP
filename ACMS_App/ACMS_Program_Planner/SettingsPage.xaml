<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ACMS_Program_Planner.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ACMS_Program_Planner"
    xmlns:models="using:ACMS_Program_Planner.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20">
        <ScrollViewer>
            <StackPanel Spacing="20">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20"/>

                <!-- Database Connection Settings -->
                <!--StackPanel>
                    <TextBlock Text="Database Connection" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,10"/>

                    <TextBlock Text="Server Address:" Margin="0,10,0,5"/>
                    <TextBox Text="{x:Bind ViewModel.ServerAddress, Mode=TwoWay}" PlaceholderText="Enter server address"/>

                    <TextBlock Text="Database Name:" Margin="0,10,0,5"/>
                    <TextBox Text="{x:Bind ViewModel.DatabaseName, Mode=TwoWay}" PlaceholderText="Enter database name"/>

                    <TextBlock Text="Username:" Margin="0,10,0,5"/>
                    <TextBox Text="{x:Bind ViewModel.Username, Mode=TwoWay}" PlaceholderText="Enter username"/>

                    <TextBlock Text="Password:" Margin="0,10,0,5"/>
                    <PasswordBox Password="{x:Bind ViewModel.Password, Mode=TwoWay}" PlaceholderText="Enter password"/>
                </StackPanel-->

                <!-- Application Settings -->
                <!--StackPanel Margin="0,20,0,0">
                    <TextBlock Text="Application Settings" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,10"/>

                    <ToggleSwitch Header="Dark Mode" IsOn="{x:Bind ViewModel.DarkModeEnabled, Mode=TwoWay}" />

                    <TextBlock Text="Refresh Interval (seconds):" Margin="0,10,0,5"/>
                    <NumberBox Value="{x:Bind ViewModel.RefreshInterval, Mode=TwoWay}" 
                              SpinButtonPlacementMode="Inline" 
                              Minimum="5" 
                              Maximum="3600"/>
                </StackPanel-->


                <!-- Save Button -->
                <Button Content="Save JSON..." 
                        Click="SaveButton_Click"
                        HorizontalAlignment="Left" 
                        Margin="0,20,0,0"/>

                <Button Content="Reset Data" 
                        Click="ResetButton_Click"
                        HorizontalAlignment="Left" 
                        Margin="0,20,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
